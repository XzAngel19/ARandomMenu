                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = Color3.fromRGB(245, 245, 245),
                BorderColor3 = Theme.surface,
                BorderSizePixel = 1,
                Position = UDim2.new(0.5, 0, 0, 0),
                Size = UDim2.new(1, 6, 0, 5),
