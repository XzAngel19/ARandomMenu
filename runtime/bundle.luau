        Name = "User",
        Default = "",
        Tooltip = "A user id or a username. Turning the module on wears them; "
            .. "Apply re-reads the box without switching off.",
    })
    disguise:CreateButton({
        Name = "Apply",
        Tooltip = "Fetch the avatar in the box and wear it now.",
        Function = function(): ()
