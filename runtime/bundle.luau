                    local renderLike: boolean = string.find(lowerName, "esp", 1, true) ~= nil
                        or string.find(lowerName, "visual", 1, true) ~= nil
                        or string.find(lowerName, "x-ray", 1, true) ~= nil
                        or string.find(lowerName, "fov", 1, true) ~= nil
