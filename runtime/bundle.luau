        Name = "Disguise",
        Category = "Fun",
        Order = 1,
        ConfigKey = "Universal.Disguise",
        Tooltip = "Wear another player's avatar, animations and emotes. "
            .. "Local only: the server and everyone else still see you.",
        Function = function(enabled: boolean): ()
