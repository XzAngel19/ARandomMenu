type LayoutMetrics = {
    mode: string,
    compact: boolean,
    touch: boolean,
    contentPadding: number,
    cardSpacing: number,
    cardHeight: number,
    cardCorner: number,
    controlHeight: number,
    optionRowHeight: number,
    sectionRowHeight: number,
    switchWidth: number,
    switchHeight: number,
    iconButton: number,
    keySlotWidth: number,
