state.fontPack = "Code"

local persistenceEnvironment: any = getfenv()
local persistenceGenv = sharedRuntimeGenv

-- These failures affect Destruct/Keep even in a release build, whose normal
-- debug warnings are muted. Keep them visible in the executor console.
local function teleportWarn(message: string): ()
    local logger: any = type(realWarn) == "function" and realWarn or warn
    logger("[" .. PRODUCT.logPrefix .. "] " .. message)
end

local function resolveTeleportQueue(): any
    for _, name: string in ipairs({"queue_on_teleport", "queueonteleport"}) do
        local queue: any = persistenceEnvironment[name]
        if type(queue) == "function" then
            return queue
        end
    end
    for _, providerName: string in ipairs({"syn", "fluxus"}) do
        local provider: any = persistenceEnvironment[providerName]
        if type(provider) == "table"
            and type(provider.queue_on_teleport) == "function" then
            return provider.queue_on_teleport
        end
    end
    return nil
end

-- The authorization lives beside the per-universe profile, not in getgenv:
-- executor environments may be recreated during a teleport. When storage
-- works, each boot/toggle gets a new token for its guarded queued snippet.
local teleportTokenPath: string = CONFIG_PROFILE_FOLDER
    .. "/Teleport_" .. CONFIG_GAME_ID .. ".txt"
local function newTeleportOwner(): string
    local ok: boolean, guid: any = pcall(function(): string
        return HttpService:GenerateGUID(false)
    end)
    if ok and type(guid) == "string" and #guid > 0 then
        return guid
    end
    return tostring(os.time()) .. ":" .. tostring(os.clock()) .. ":"
        .. tostring(math.random(1, 1073741824)) .. ":" .. tostring({})
end

local teleportOwner: string = newTeleportOwner()
local teleportSerial: number = 0
local teleportToken: string = ""
local teleportGuarded: boolean = false
local function writeTeleportToken(value: string): boolean
    if type(readfile) ~= "function" or type(writefile) ~= "function" then
        return false
    end
    local ok: boolean = pcall(function(): ()
        if type(isfolder) == "function" and type(makefolder) == "function" then
            if not isfolder(CONFIG_FOLDER) then
                makefolder(CONFIG_FOLDER)
            end
            if not isfolder(CONFIG_PROFILE_FOLDER) then
                makefolder(CONFIG_PROFILE_FOLDER)
            end
        end
        writefile(teleportTokenPath, value)
    end)
    if not ok then
        return false
    end
    local readOk: boolean, stored: any = pcall(readfile, teleportTokenPath)
    return readOk and stored == value
end

local function claimTeleportToken(): ()
    teleportSerial += 1
    teleportToken = teleportOwner .. ":" .. tostring(teleportSerial)
    teleportGuarded = writeTeleportToken(teleportToken)
end

local function revokeTeleportToken(): ()
    if not teleportGuarded then
        return
    end
    if type(readfile) ~= "function" then
        teleportWarn("could not read the teleport token; revocation is unverified")
        return
    end
    local ok: boolean, stored: any = pcall(readfile, teleportTokenPath)
    if not ok then
        teleportWarn("could not read the teleport token; revocation is unverified")
        return
    end
    if stored ~= teleportToken then
        return -- A newer runtime already owns this universe's authorization.
    end
    if not writeTeleportToken("stopped:" .. teleportToken) then
        -- If overwriting stopped working, try deleting only our own token.
        local checked: boolean, current: any = pcall(readfile, teleportTokenPath)
        local removed: boolean = false
        if checked and current == teleportToken and type(delfile) == "function" then
            local deleted: boolean, result: any = pcall(delfile, teleportTokenPath)
            removed = deleted and result ~= false
        end
        local stillOk: boolean, remaining: any = pcall(readfile, teleportTokenPath)
        if (stillOk and remaining == teleportToken) or (not stillOk and not removed) then
            teleportWarn("could not revoke the teleport token")
        end
    end
end

local function buildTeleportSnippet(token: string, guarded: boolean): string
    -- Arm on GameId, not PlaceId: instanced places in one game share a universe.
    local armedGameId: number = game.GameId
    local guardLines: {string} = guarded and {
        "    if type(readfile) ~= \"function\" then return false end",
        "    local ok, value = pcall(readfile, " .. string.format("%q", teleportTokenPath) .. ")",
        "    return ok and value == " .. string.format("%q", token),
    } or {"    return true"}
    return table.concat({
        "local genv = (type(getgenv) == \"function\" and getgenv()) or {}",
        "local function authorized()",
        table.concat(guardLines, "\n"),
        "end",
        "local function allowed()",
        "    return genv.WURST_STOPPED ~= true and game.GameId == "
            .. tostring(armedGameId) .. " and authorized()",
        "end",
        "if genv.WURST_STOPPED == true or not authorized() then return end",
        "if not game:IsLoaded() then game.Loaded:Wait() end",
        "if not allowed() then return end",
        "task.wait(1)",
        "if not allowed() then return end",
        "local ok, err = pcall(function()",
        "    local source = game:HttpGet("
            .. string.format("%q", RUNTIME_RAW_BASE .. "src/Wurst.lua?t=")
            .. " .. tostring(os.time()))",
        "    if not allowed() then return end",
        "    genv.WURST_BRANCH = " .. string.format("%q", RUNTIME_BRANCH),
        "    loadstring(source)()",
        "end)",
        "if not ok then warn(\"[Wurst] teleport reinject failed: \" .. tostring(err)) end",
    }, "\n")
end

local queueTeleport: any = resolveTeleportQueue()
local contract: any = {
    supported = type(queueTeleport) == "function",
    enabled = false,
    closed = false,
    queued = false,
}
state.teleportPersist = contract
local teleportConnection: any = nil
local appliedTeleportSetting: boolean? = nil
local initialGenv: any = persistenceGenv()
if initialGenv then
    initialGenv.WURST_TP_OWNER = teleportOwner
end
claimTeleportToken()

local function ownsTeleportSession(): boolean
    local genv: any = persistenceGenv()
    return not genv or genv.WURST_TP_OWNER == teleportOwner
end

-- A previous VM can still have delayed profile/telemetry writers even when
-- getgenv was replaced. Do not let them overwrite the new universe owner.
local function ownsRuntimeData(): boolean
    local genv: any = persistenceGenv()
    if genv and genv.WURST_TP_OWNER ~= nil
        and genv.WURST_TP_OWNER ~= teleportOwner then
        return false
    end
    if teleportGuarded and type(readfile) == "function" then
        local ok: boolean, value: any = pcall(readfile, teleportTokenPath)
        if ok then
            return value == teleportToken or value == "stopped:" .. teleportToken
        end
    end
    -- If the storage API becomes unreadable, ownership cannot be verified
    -- across VMs; retain the existing best-effort getgenv behaviour.
    return true
end
configWriteAllowed = ownsRuntimeData
state.ownsRuntimeData = ownsRuntimeData

local function disconnectTeleport(): ()
    if teleportConnection then
        pcall(function(): ()
            teleportConnection:Disconnect()
        end)
        teleportConnection = nil
    end
end
local function markTeleportStopped(): ()
    local genv: any = persistenceGenv()
    if genv and genv.WURST_TP_OWNER == teleportOwner then
        genv.WURST_STOPPED = true
        genv.WURST_TP_OWNER = nil
    end
end

local function warnUnguardedTeleport(): ()
    if not teleportGuarded and not contract._unguardedSaid then
        contract._unguardedSaid = true
        teleportWarn("teleport token storage unavailable; "
            .. "a queue already submitted during teleport may not be revocable")
    end
end

local function onTeleport(status: any): ()
    if contract.closed or not contract.enabled or not ownsTeleportSession() then
        return
    end
    if status == Enum.TeleportState.Failed then
        if contract.queued then
            -- A failed teleport may leave its old source in an executor queue.
            contract.queued = false
            revokeTeleportToken()
            claimTeleportToken()
        end
        return
    end
    if status ~= Enum.TeleportState.Started
        and status ~= Enum.TeleportState.WaitingForServer
        and status ~= Enum.TeleportState.InProgress then
        return
    end
    if contract.queued then
        return
    end
    warnUnguardedTeleport()
    local ok: boolean, result: any = pcall(
        queueTeleport,
        buildTeleportSnippet(teleportToken, teleportGuarded)
    )
    if ok and result ~= false then
        contract.queued = true
    else
        teleportWarn("teleport queue failed: " .. tostring(result))
    end
end

contract.SetEnabled = function(enabled: boolean): ()
    if contract.closed or not ownsTeleportSession() then
        return
    end
    local wanted: boolean = enabled == true
    contract.enabled = wanted
    if appliedTeleportSetting == wanted then
        return
    end
    if appliedTeleportSetting ~= nil then
        revokeTeleportToken()
        claimTeleportToken()
    end
    appliedTeleportSetting = wanted
    contract.queued = false
    disconnectTeleport()
    local genv: any = persistenceGenv()
    if genv and genv.WURST_TP_OWNER == teleportOwner then
        genv.WURST_STOPPED = not wanted
    end
    if not wanted then
        return
    end
    if not contract.supported then
        if not contract._unsupportedSaid then
            contract._unsupportedSaid = true
            teleportWarn("queue_on_teleport is not available; "
                .. "the menu cannot follow teleports here")
        end
        return
    end
    warnUnguardedTeleport()
    local connected: boolean, result: any = pcall(function(): any
        return LocalPlayer.OnTeleport:Connect(onTeleport)
    end)
    if connected then
        teleportConnection = result
    else
        contract.supported = false
        teleportWarn("could not observe teleport: " .. tostring(result))
    end
end
contract.Sync = function(): ()
    contract.SetEnabled(contract.enabled)
end

-- Ordinary GUI teardown during a teleport must leave the submitted token
-- intact. Explicit Destruct always revokes it, including after teardown.
contract.Close = function(): ()
    if contract.closed then
        return
    end
    local preserve: boolean = contract.queued and contract.enabled and ownsTeleportSession()
    contract.closed = true
    disconnectTeleport()
    if not preserve then
        revokeTeleportToken()
        markTeleportStopped()
    end
    contract.enabled = false
end
contract.Stop = function(): ()
    contract.closed = true
    contract.enabled = false
    disconnectTeleport()
    revokeTeleportToken()
    markTeleportStopped()
end
contract.SetEnabled(configData.states["ClickGUI.Keepafterteleport"] ~= false)

state.menuStyleListeners = {} :: {(string) -> ()}

state.SetMenuStyle = function(style: string, openImmediately: boolean?): ()
    if style ~= "Wurst" and style ~= "Navigator" then
        return
    end
    state.menuStyle = style
    configData.values["UI.MenuStyle"] = style
    queueConfigSave()
    local navigator: any = state.navigator
    local navigatorOpen: boolean = navigator ~= nil
        and navigator.root ~= nil
        and navigator.root.Visible == true
    if style == "Wurst" then
        if navigatorOpen and type(navigator.Close) == "function" then
            navigator.Close()
        end
        if openImmediately and not state.visible then
            state.setMenuVisible(true)
        end
    else
        if state.visible then
            state.setMenuVisible(false)
        end
        if openImmediately and navigator
            and type(navigator.Open) == "function" then
            navigator.Open()
        end
    end
    for _, listener: (string) -> () in ipairs(state.menuStyleListeners) do
        pcall(listener, style)
    end
end

state.openMenuSurface = function(): ()
    if state.menuStyle == "Navigator" then
        local navigator: any = state.navigator
        if navigator and navigator.root and navigator.root.Visible then
            navigator.Close()
            return
        end

        if state.visible then
            state.setMenuVisible(false)
        end
        if navigator and type(navigator.Open) == "function" then
            navigator.Open()
            return
        end
    end

    local navigator: any = state.navigator
    if navigator and navigator.root and navigator.root.Visible
        and type(navigator.Close) == "function" then
        navigator.Close()
    end
    state.setMenuVisible(not state.visible)
end

-- Camera replacement can briefly expose a zero-sized viewport. Keep the last
-- valid size so the menu is not rescaled or moved during that transition.
local function validLayoutViewport(viewport: any): boolean
    return viewport ~= nil and type(viewport.X) == "number" and type(viewport.Y) == "number"
        and viewport.X > 1 and viewport.Y > 1
        and viewport.X < math.huge and viewport.Y < math.huge
end
local bootViewport: any = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
state.layoutViewport = if validLayoutViewport(bootViewport) then bootViewport else Vector2.new(1280, 720)
state.layout = computeLayoutMetrics(state.layoutViewport, UserInputService.TouchEnabled)
state.layoutListeners = {} :: {(LayoutMetrics) -> ()}

state.onLayout = function(listener: (LayoutMetrics) -> ()): ()
    table.insert(state.layoutListeners, listener)
end

state.refreshLayout = function(force: boolean?): boolean
    local camera: Camera? = workspace.CurrentCamera
    local viewport: any = camera and camera.ViewportSize
    if not validLayoutViewport(viewport) then
        if force then state.layoutNeedsRefresh = true end
        return false
    end
    local nextLayout: LayoutMetrics = computeLayoutMetrics(viewport, UserInputService.TouchEnabled)
    local previous: LayoutMetrics = state.layout
    local previousViewport: Vector2 = state.layoutViewport
    local forceRefresh: boolean = force == true or state.layoutNeedsRefresh == true
    state.layoutNeedsRefresh = false
    if not forceRefresh
        and previous.mode == nextLayout.mode
        and previous.cardHeight == nextLayout.cardHeight
        and previousViewport.X == viewport.X and previousViewport.Y == viewport.Y then
        return true
    end
    state.layoutViewport = viewport
    state.layout = nextLayout
    for _, listener: (LayoutMetrics) -> () in ipairs(state.layoutListeners) do
        local ok: boolean, failure: any = pcall(listener, nextLayout)
        if not ok then
            warn("[" .. PRODUCT.name .. "] layout listener: " .. tostring(failure))
        end
    end
    return true
end

local function trackUiConnection(
    connection: RBXScriptConnection
): RBXScriptConnection
    table.insert(state.uiConnections, connection)
    return connection
end

local menuCursorState: any = {
    owned = false,
    applying = false,
    behavior = nil,
    iconEnabled = nil,
    -- v162: how many times this menu session has re-asserted the cursor. A
    -- game that keeps setting it back (shift lock does exactly that, every
    -- frame) is not a bug to fight, it is the player's own state.
    fights = 0,
    fightStart = 0,
    yielded = false,
}
-- Re-assertions allowed before the menu lets the game own the cursor again.
local CURSOR_FIGHT_LIMIT: number = 8
local CURSOR_FIGHT_WINDOW: number = 1

-- v162 ‚Äî SHIFT LOCK. Two rules, both learned from a reported regression:
--
-- 1. Only undo OUR OWN write. The old release path always wrote a behavior
--    back, so a shift lock the game had just enabled (pressing the same key
--    that closes the menu) was overwritten with Default on the way out: the
--    mouse stayed free and shift lock looked broken from then on.
-- 2. Never write LockCenter. If the player was shift-locked when the menu
--    opened, restoring that value would lock the camera without the game's own
--    shift-lock state, which is worse than releasing to Default.
local function setMenuCursorUnlocked(visible: boolean): ()
    if menuCursorState.applying then
        return
    end
    if visible then
        if menuCursorState.yielded then
            return
        end
        if not menuCursorState.owned then
            menuCursorState.behavior = UserInputService.MouseBehavior
            menuCursorState.iconEnabled = UserInputService.MouseIconEnabled
            menuCursorState.owned = true
        end
        menuCursorState.applying = true
        pcall(function(): ()
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end)
        menuCursorState.applying = false
        return
    end
    if not menuCursorState.owned then
        menuCursorState.yielded = false
        return
    end
    menuCursorState.applying = true
    pcall(function(): ()
        -- Rule 1: if the cursor is not where we left it, somebody else (the
        -- game) moved it on purpose and that state stays.
        if UserInputService.MouseBehavior == Enum.MouseBehavior.Default then
            local saved: any = menuCursorState.behavior
            if saved == Enum.MouseBehavior.LockCenter or saved == nil then
                saved = Enum.MouseBehavior.Default
            end
            UserInputService.MouseBehavior = saved
        end
        if UserInputService.MouseIconEnabled == true
            and menuCursorState.iconEnabled ~= nil then
            UserInputService.MouseIconEnabled = menuCursorState.iconEnabled
        end
    end)
    menuCursorState.applying = false
    menuCursorState.behavior = nil
    menuCursorState.iconEnabled = nil
    menuCursorState.owned = false
    menuCursorState.fights = 0
    menuCursorState.yielded = false
end

local function enforceMenuCursor(): ()
    if menuCursorState.applying then
        return
    end
    if state.visible ~= true or not menuCursorState.owned then
        return
    end

    local rightClicking: boolean = false
    pcall(function(): ()
        rightClicking = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    end)
    if rightClicking then
        return
    end
    if UserInputService.MouseBehavior == Enum.MouseBehavior.Default
        and UserInputService.MouseIconEnabled == true then
        return
    end
    -- Rule 3: a cursor that keeps being taken back is the player's shift lock.
    -- Re-assert a few times (a camera script may lock it once on open) and then
    -- stop, instead of fighting it sixty times a second for as long as the
    -- menu is open.
    local now: number = os.clock()
    if now - menuCursorState.fightStart > CURSOR_FIGHT_WINDOW then
        menuCursorState.fightStart = now
        menuCursorState.fights = 0
    end
    menuCursorState.fights += 1
    if menuCursorState.fights > CURSOR_FIGHT_LIMIT then
        menuCursorState.yielded = true
        menuCursorState.fights = 0
        return
    end
    setMenuCursorUnlocked(true)
end
pcall(function(): ()
    trackUiConnection(UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(enforceMenuCursor))
    trackUiConnection(UserInputService:GetPropertyChangedSignal("MouseIconEnabled"):Connect(enforceMenuCursor))
    trackUiConnection(UserInputService.InputEnded:Connect(function(input: InputObject): ()
        if input.UserInputType == Enum.UserInputType.MouseButton2 and state.visible then
            task.defer(function(): ()
                if state.visible and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                    setMenuCursorUnlocked(true)
                end
            end)
        end
    end))
    -- v162: a teleport/respawn can reset the cursor under us; releasing is
    -- always safe, holding a stale ownership is not.
    if LocalPlayer then
        pcall(function(): ()
            trackUiConnection(LocalPlayer.CharacterAdded:Connect(function(): ()
                if state.visible ~= true then
                    menuCursorState.owned = false
                    menuCursorState.yielded = false
                end
            end))
        end)
    end
end)

-- Roblox blurs the 3D scene, not GUI text; share the existing effect rather
-- than allocating a new BlurEffect every time a selector opens.
state.setChoiceBlur = function(active: boolean): ()
    state.choiceBlur = active
    if MenuBlur then
        MenuBlur.Enabled = state.visible == true or active
    end
end

local menuVisibilityListeners: {(boolean) -> ()} = {}
state.addMenuVisibilityListener = function(listener: (boolean) -> ()): ()
    table.insert(menuVisibilityListeners, listener)
end

local function setMenuVisibleCore(visible: boolean): ()
    state.visible = visible
    setMenuCursorUnlocked(visible)
    if MenuBlur then
        pcall(function(): ()
            MenuBlur.Enabled = visible == true or state.choiceBlur == true
        end)
    end
    for _, listener: (boolean) -> () in ipairs(menuVisibilityListeners) do
        pcall(listener, visible)
    end
end
state.setMenuVisible = setMenuVisibleCore

type AssetDefinition = {
    url: string,
    fileName: string,
    fallback: string,
    version: number?,
    assetType: string?,
}

do
local generatedEnvironment: any = nil
if type(executorGlobals.getgenv) == "function" then
    local environmentOk: boolean, resolvedEnvironment: any = pcall(
        executorGlobals.getgenv
    )
    if environmentOk and type(resolvedEnvironment) == "table" then
        generatedEnvironment = resolvedEnvironment
    end
end

local function getEnvironmentValue(name: string): any
    if generatedEnvironment and generatedEnvironment[name] ~= nil then
        return generatedEnvironment[name]
    end
    return executorGlobals[name]
end

