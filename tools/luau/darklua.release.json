  "//2": "fails when this list and RELEASE_RULES drift apart. Rule docs:",
  "//3": "https://darklua.com/docs/ (seaofvoices/darklua)",
  "output": "build/Wurst.min.lua",
  "rules": [
    "remove_types",
    "remove_debug_profiling",
    "remove_compound_assignment",
