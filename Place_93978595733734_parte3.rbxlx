<Weight>400</Weight>
<Style>Normal</Style>
</Font>
<float name="LineHeight">0.750000000000</float>
<string name="LocalizedText">Whenever you Chain a &lt;font color=&quot;#4A90E2&quot;&gt;Survivor&lt;/font&gt;, you gain &lt;font color=&quot;#C29EFF&quot;&gt;1 Token&lt;/font&gt;. When you break a &lt;font color=&quot;#7FC8F8&quot;&gt;Pallet&lt;/font&gt;, consume &lt;font color=&quot;#C29EFF&quot;&gt;1 Token&lt;/font&gt; to inflict &lt;font color=&quot;#FF5E5E&quot;&gt;15% Slowness&lt;/font&gt; on all Survivors within your &lt;font color=&quot;#C29EFF&quot;&gt;Intent Radius&lt;/font&gt; for &lt;font color=&quot;#CD7F32&quot;&gt;2&lt;/font&gt;/&lt;font color=&quot;#3FBF3F&quot;&gt;3&lt;/font&gt;/&lt;font color=&quot;#E53935&quot;&gt;4&lt;/font&gt; seconds. You see the affected Survivors&apos; &lt;font color=&quot;#C29EFF&quot;&gt;auras&lt;/font&gt; for the duration of the slow and apply the &lt;font color=&quot;#FF5E5E&quot;&gt;Silenced&lt;/font&gt; Status Effect for &lt;font color=&quot;#CD7F32&quot;&gt;20&lt;/font&gt;/&lt;font color=&quot;#3FBF3F&quot;&gt;30&lt;/font&gt;/&lt;font color=&quot;#E53935&quot;&gt;35&lt;/font&gt; seconds.
&lt;br/&gt;&quot;All according to my master plan&quot;</string>
<string name="Name">perk1desc</string>
