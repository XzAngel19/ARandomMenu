*.log
*.tmp
Thumbs.db
.DS_Store
runtime-config/
local-profiles/
/compile-*.txt
/register-stats.json
__pycache__/
*.pyc

# Official Minecraft font extracts and derived atlases are local build inputs.
# Mojang assets are downloaded explicitly and never vendored.
/cache/
/assets/font/minecraft-atlas.png
/assets/font/minecraft-atlas.json
/build/

# Unpacked place dumps. reference/places/ holds the compressed capture; the
# .rbxlx it expands to is 170 MB of XML and is a build input, never a commit.
/reference/places/*.rbxlx
/reference/places/*.rbxl
/reference/places/*.rbxmx
