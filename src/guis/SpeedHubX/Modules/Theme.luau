-- SpeedHubX / Modules / Theme.luau
-- Visual tokens replicated from the reference screenshot (Speed Hub X 3.7.0).
-- Pure data module: no Instances are created here.
--
-- Module convention (used by every file in Modules/):
--   The file returns a factory `function(Deps) -> Module`. The standalone
--   bundle (SpeedHubX.lua, generated by tools/build_speedhubx_bundle.py)
--   calls each factory once with its dependencies. Outside the bundle you
--   can do the same wiring by hand -- see README.md.

return function(_Deps: any)
	local Theme = {}

	-- Palette (sampled from the screenshot)
	Theme.Color = {
		Window = Color3.fromRGB(10, 10, 10), -- main window, near-black
		Card = Color3.fromRGB(30, 30, 30), -- control rows
		CardHover = Color3.fromRGB(36, 36, 36),
		ValueBox = Color3.fromRGB(42, 42, 42), -- dropdown value box / toggle track
		KnobOff = Color3.fromRGB(56, 56, 56), -- toggle indicator, off
		NavIdle = Color3.fromRGB(35, 35, 35), -- sidebar buttons, idle
		NavHover = Color3.fromRGB(44, 44, 44),
		Accent = Color3.fromRGB(204, 0, 0), -- selected nav button
		AccentHover = Color3.fromRGB(224, 10, 10),
		AccentText = Color3.fromRGB(255, 128, 128), -- label on selected nav button
		IndicatorOn = Color3.fromRGB(255, 30, 30), -- toggle dot, on
		Edge = Color3.fromRGB(110, 0, 0), -- thin dark-red window edge
		Text = Color3.fromRGB(245, 245, 245),
		TextDim = Color3.fromRGB(190, 190, 190), -- sidebar labels
		TextMuted = Color3.fromRGB(138, 138, 138), -- descriptions / "BETA"
		SliderFill = Color3.fromRGB(204, 0, 0),
		ScrollBar = Color3.fromRGB(70, 70, 70),
	}

	Theme.Font = {
		Title = Enum.Font.GothamMedium,
		Section = Enum.Font.GothamBold,
		Label = Enum.Font.GothamMedium,
		Value = Enum.Font.GothamBold,
		Description = Enum.Font.Gotham,
	}

	Theme.TextSize = {
		Title = 21,
		Section = 23,
		Label = 16,
		Value = 21,
		Description = 13,
		Nav = 17,
	}

	-- Geometry (offset pixels at scale 1; the window is 1020 x 640 like the
	-- ~1015 x 640 window in the 1568 x 882 reference image)
	Theme.Metric = {
		WindowSize = Vector2.new(1020, 640),
		WindowCorner = 10,
		CardCorner = 8,
		CardHeight = 62,
		DropdownHeight = 56,
		NavButtonHeight = 50,
		NavButtonGap = 11,
		SidebarWidth = 260,
		ContentGap = 22, -- sidebar right edge -> content left edge
		WindowPadding = 20,
		CardGap = 10,
		SectionGap = 18,
		ToggleSize = 36,
	}

	Theme.Title = "Speed Hub X | Version: 3.7.0"
	Theme.GuiName = "SpeedHubX"

	return Theme
end
