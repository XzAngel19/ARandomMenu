        TextWrapped = true,
        ZIndex = 5,
    }).Parent = panel

    return { Frame = holder }
end

---------------------------------------------------------------------------
-- Page shell — one per sidebar tab
---------------------------------------------------------------------------
function Components.makePage(pagesHost, name)
    local page = Util.create("Frame", {
        Name = "Page_" .. name,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        ZIndex = 4,
    })
    page.Parent = pagesHost
    return page
end

return Components
end)

