--!strict

local executorEnvironment: any = getfenv()
local cloneReference: (Instance) -> Instance = (
    executorEnvironment.cloneref
    or function(instance: Instance): Instance
        return instance
    end
) :: (Instance) -> Instance
local HttpService: HttpService =
    cloneReference(game:GetService("HttpService")) :: HttpService

local REQUIRED_RUNTIME_MARKER: string =
    "Initialization error — check executor console"

-- Branch selection.
--
-- `main` is what everybody gets. Setting `ARANDOMMENU_BRANCH` before running
-- this loader points it at a work branch instead, and the bootstrap it
-- downloads reads the same global to fetch its game modules from there too —
-- so a branch can be tested end to end without merging it first:
--
--   getgenv().ARANDOMMENU_BRANCH = "arena/01a01c6e-arandommenu"
local REQUESTED_BRANCH: string = "main"
do
    local override: any = executorEnvironment.ARANDOMMENU_BRANCH
    if type(override) == "string" and override ~= "" then
        REQUESTED_BRANCH = (string.gsub(override, "^refs/heads/", ""))
    end
end

local MAIN_SOURCE_URL: string =
    "https://raw.githubusercontent.com/XzAngel19/ARandomMenu/refs/heads/main/ARandomMenu.luau"
local BRANCH_SOURCE_URL: string =
    "https://raw.githubusercontent.com/XzAngel19/ARandomMenu/refs/heads/"
        .. REQUESTED_BRANCH
        .. "/ARandomMenu.luau"
local SAFETY_SOURCE_URL: string =
    "https://raw.githubusercontent.com/XzAngel19/ARandomMenu/4b10e4bfe00aa356afb3e0420a72e745327f6259/ARandomMenu.luau"

type SourceCandidate = {
    label: string,
    url: string,
}

local SOURCE_CANDIDATES: {SourceCandidate} = {}
if REQUESTED_BRANCH ~= "main" then
    table.insert(SOURCE_CANDIDATES, {
        label = "branch " .. REQUESTED_BRANCH,
        url = BRANCH_SOURCE_URL,
    })
end
table.insert(SOURCE_CANDIDATES, {label = "main", url = MAIN_SOURCE_URL})
table.insert(SOURCE_CANDIDATES, {
    label = "known-good snapshot",
    url = SAFETY_SOURCE_URL,
})

local function validateSource(candidate: any): (boolean, string?)
    if type(candidate) ~= "string" then
        return false, "la respuesta no es una cadena (tipo: "
            .. type(candidate) .. ")"
    end
    local source: string = candidate
    if #source < 1024 then
        return false, "la respuesta es demasiado corta ("
            .. tostring(#source) .. " bytes)"
    end

    local prefix: string = string.lower(string.sub(source, 1, 512))
    prefix = string.gsub(prefix, "^\239\187\191", "")
    prefix = string.gsub(prefix, "^%s+", "")
    if string.find(prefix, "404: not found", 1, true) == 1 then
        return false, "GitHub devolvió 404: Not Found"
    end
    if string.find(prefix, "<!doctype html", 1, true) == 1
        or string.find(prefix, "<html", 1, true) == 1 then
        return false, "el servidor devolvió HTML en lugar de Lua"
    end
    if string.match(prefix, '^%{%s*"message"%s*:') then
        return false, "el servidor devolvió un error JSON"
    end
    if string.find(source, REQUIRED_RUNTIME_MARKER, 1, true) == nil then
        return false, "runtime obsoleto: falta el marcador del hotfix 0/0"
    end
    return true, nil
end

local function downloadCurrentSource(): (string?, string?)
    local failures: {string} = {}
    for _, candidate: SourceCandidate in ipairs(SOURCE_CANDIDATES) do
        local requestUrl: string = candidate.url
            .. "?loader=v3&nocache="
            .. HttpService:GenerateGUID(false)
        print("[RTM:Loader] Descargando " .. candidate.label)
        local downloaded: boolean, bodyOrError: any = pcall(function(): string
            return (game :: any):HttpGet(requestUrl, true)
        end)
        if downloaded then
            local valid: boolean, validationError: string? =
                validateSource(bodyOrError)
            if valid then
                print("[RTM:Loader] Runtime válido: "
                    .. candidate.label .. " · " .. tostring(#bodyOrError) .. " bytes")
                return bodyOrError :: string, nil
            end
            table.insert(failures, candidate.label .. ": "
                .. tostring(validationError))
        else
            table.insert(failures, candidate.label .. ": HTTP "
                .. tostring(bodyOrError))
        end
    end
    return nil, table.concat(failures, " | ")
end

local function readLocalFallback(): (string?, string?)
    local readFile: any = executorEnvironment.readfile
    local isFile: any = executorEnvironment.isfile
    local path: string = "ARandomMenu.luau"
    if type(readFile) ~= "function" then
        return nil, "readfile no está disponible"
    end
    if type(isFile) == "function" and not isFile(path) then
        return nil, "no existe " .. path
    end
    local readOk: boolean, localSource: any = pcall(readFile, path)
    if not readOk then
        return nil, "readfile falló: " .. tostring(localSource)
    end
    local valid: boolean, validationError: string? = validateSource(localSource)
    if not valid then
        return nil, "fallback local rechazado: " .. tostring(validationError)
    end
    return localSource :: string, nil
end

local source: string? = nil
local remoteError: string? = nil
source, remoteError = downloadCurrentSource()
if source == nil then
    warn("[RTM:Loader] Remotos no disponibles: " .. tostring(remoteError))
    local fallbackSource: string?, fallbackError: string? = readLocalFallback()
    if fallbackSource == nil then
        warn("[RTM:Loader] Sin runtime seguro: " .. tostring(fallbackError))
        return nil
    end
    source = fallbackSource
    print("[RTM:Loader] Usando fallback local verificado")
end

local compiler: any = executorEnvironment.loadstring or loadstring
if type(compiler) ~= "function" then
    warn("[RTM:Loader] El executor no expone loadstring")
    return nil
end
local invoked: boolean, chunkOrError: any, returnedError: any = pcall(
    compiler,
    source,
    "@ARandomMenu.luau"
)
if not invoked or type(chunkOrError) ~= "function" then
    warn("[RTM:Loader] Error de compilación: "
        .. tostring(invoked and returnedError or chunkOrError))
    return nil
end
print("[RTM:Loader] Compilación correcta · loader v3")

local executed: boolean, result: any = xpcall(
    chunkOrError,
    function(message: any): string
        local text: string = tostring(message)
        if debug and type(debug.traceback) == "function" then
            return debug.traceback(text, 2)
        end
        return text
    end
)
if not executed then
    warn("[RTM:Loader] Error durante la ejecución:\n" .. tostring(result))
    return nil
end
print("[RTM:Loader] Ejecución completada")
return result
