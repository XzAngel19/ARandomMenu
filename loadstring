--!strict

local environment: any = getfenv()
local cloneReference: (Instance) -> Instance = environment.cloneref or function(instance: Instance): Instance
    return instance
end
local httpService: HttpService = cloneReference(game:GetService("HttpService")) :: HttpService
local branch: string = "main"

if type(environment.ARANDOMMENU_BRANCH) == "string" and environment.ARANDOMMENU_BRANCH ~= "" then
    branch = string.gsub(environment.ARANDOMMENU_BRANCH, "^refs/heads/", "")
end

local urls: {string} = {}
if branch ~= "main" then
    table.insert(urls, "https://raw.githubusercontent.com/XzAngel19/ARandomMenu/refs/heads/" .. branch .. "/src/ARandomMenu.luau")
end
table.insert(urls, "https://raw.githubusercontent.com/XzAngel19/ARandomMenu/refs/heads/main/src/ARandomMenu.luau")

local function valid(source: any): boolean
    if type(source) ~= "string" or #source < 1024 then
        return false
    end
    local prefix: string = string.lower(string.gsub(string.sub(source, 1, 512), "^%s+", ""))
    return string.find(prefix, "404: not found", 1, true) ~= 1
        and string.find(prefix, "<!doctype html", 1, true) ~= 1
        and string.find(prefix, "<html", 1, true) ~= 1
end

local source: string? = nil
for _, url: string in urls do
    local success: boolean, response: any = pcall(function(): string
        return (game :: any):HttpGet(url .. "?nocache=" .. httpService:GenerateGUID(false), true)
    end)
    if success and valid(response) then
        source = response
        break
    end
end

if source == nil and type(environment.readfile) == "function" then
    local success: boolean, response: any = pcall(environment.readfile, "src/ARandomMenu.luau")
    if success and valid(response) then
        source = response
    end
end

if source == nil then
    warn("[Wurst] Source unavailable")
    return nil
end

local compiler: any = environment.loadstring or loadstring
if type(compiler) ~= "function" then
    warn("[Wurst] loadstring unavailable")
    return nil
end

local chunk: any, compileError: any = compiler(source, "@src/ARandomMenu.luau")
if type(chunk) ~= "function" then
    warn("[Wurst] " .. tostring(compileError))
    return nil
end

local success: boolean, result: any = xpcall(chunk, function(message: any): string
    return debug and type(debug.traceback) == "function" and debug.traceback(tostring(message), 2) or tostring(message)
end)
if not success then
    warn("[Wurst] " .. tostring(result))
    return nil
end
return result
