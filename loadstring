--!strict

type Chunk = () -> any
type Compiler = (source: string, chunkName: string?) -> (Chunk?, string?)

local SOURCE_URL: string =
    "https://raw.githubusercontent.com/XzAngel19/ARandomMenu/main/ARandomMenu.luau"
local HttpService: HttpService = game:GetService("HttpService")
local source: string = game:HttpGet(
    SOURCE_URL .. "?nocache=" .. HttpService:GenerateGUID(false),
    true
)
local compiler: Compiler = (loadstring :: any) :: Compiler
local chunk: Chunk?, compileError: string? = compiler(
    source,
    "@ARandomMenu.luau"
)
assert(
    chunk,
    "ARandomMenu failed to compile: " .. tostring(compileError)
)

return (chunk :: Chunk)()
