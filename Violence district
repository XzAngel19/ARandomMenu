	-- Pestaña Config 100% Fiel al Original
	function Hub:AddConfigTab()
		local cfgTab = Hub:AddTab("Config")
		local setSec = cfgTab:AddSection("Settings", "left")
		local uiSec = cfgTab:AddSection("Interface", "right")

		local statusLabel = create("TextLabel", {
			Size = UDim2.new(1, -8, 0, 18),
			Position = UDim2.new(0, 4, 1, -20),
			BackgroundTransparency = 1,
			Text = "",
			TextColor3 = DIM_TEXT_COLOR,
			TextSize = 12,
			Font = TEXT_FONT,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 5,
		}, cfgTab.Page)

		local function setStatus(message)
			statusLabel.Text = message
			statusLabel.TextTransparency = 0
			task.delay(3, function()
				if statusLabel.Text == message then
					tween(statusLabel, MEDIUM_TWEEN, { TextTransparency = 1 })
				end
			end)
		end

		setSec:AddButton("Save Settings", function()
			if not writefile then return setStatus("Saving is not supported here.") end
			local ok, result = pcall(function()
				if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
				writefile(CONFIG_FILE, httpService:JSONEncode(Hub.values))
			end)
			setStatus(ok and "Settings saved." or ("Save failed: " .. tostring(result)))
		end)

		setSec:AddButton("Load Settings", function()
			if not (readfile and isfile and isfile(CONFIG_FILE)) then return setStatus("No saved settings found.") end
			local ok, data = pcall(function() return httpService:JSONDecode(readfile(CONFIG_FILE)) end)
			if not ok or typeof(data) ~= "table" then return setStatus("Settings file is corrupted.") end
			for k, v in data do
				if Hub.setters[k] then pcall(Hub.setters[k], v) end
			end
			setStatus("Settings loaded.")
		end)

		setSec:AddButton("Reset Settings", function()
			for k, v in Hub.defaults do
				if Hub.setters[k] then Hub.setters[k](v) end
			end
			setStatus("Settings reset.")
		end)

		setSec:AddButton("Copy Settings", function()
			if not setclipboard then return setStatus("Clipboard is not supported here.") end
			setclipboard(httpService:JSONEncode(Hub.values))
			setStatus("Settings copied.")
		end)

		setSec:AddToggle("Auto Save", false, nil)

		uiSec:AddCycle("Menu Keybind", { "RightShift", "Insert", "RightControl", "Delete", "End" }, function(keyName)
			Hub.menuKey = Enum.KeyCode[keyName] or Enum.KeyCode.RightShift
		end)

		uiSec:AddToggle("Keybind Hints", true, function(visible)
			for _, kbBtn in Hub.keyLabels do kbBtn.Visible = visible end
		end)

		uiSec:AddButton("Reset Window", function()
			windowWidth, windowHeight = WINDOW_WIDTH, WINDOW_HEIGHT
			minimized = false
			resizeHandle.Visible = true
			tween(window, MEDIUM_TWEEN, {
				Size = UDim2.fromOffset(windowWidth, windowHeight),
				Position = UDim2.new(0.5, -windowWidth / 2, 0.5, -windowHeight / 2),
			})
		end)

		uiSec:AddButton("Unload GUI", function()
			tween(windowScale, FAST_TWEEN, { Scale = 0 }).Completed:Connect(function()
				screenGui:Destroy()
			end)
		end)

		task.spawn(function()
			while screenGui.Parent do
				if Hub.values["Auto Save"] and writefile then
					pcall(function()
						if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
							makefolder(CONFIG_FOLDER)
						end
						writefile(CONFIG_FILE, httpService:JSONEncode(Hub.values))
					end)
				end
				task.wait(5)
			end
		end)
	end

	return Hub
end

