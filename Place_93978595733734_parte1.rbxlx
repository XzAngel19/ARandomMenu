local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;);
local Players = game:GetService(&quot;Players&quot;);
local Shop = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;):WaitForChild(&quot;Shop&quot;);
local PurchasePerk = Shop:WaitForChild(&quot;PurchasePerk&quot;);
local GetPerkInfo = Shop:WaitForChild(&quot;GetPerkInfo&quot;);
local _ = Players.LocalPlayer;
local script_Parent = script.Parent;
local Parent = script_Parent.Parent;
local Title = Parent:FindFirstChild(&quot;Title&quot;);
local MessageLabel = Parent:FindFirstChild(&quot;MessageLabel&quot;);
local emblem = script.Parent.emblem;

if not (Title and script_Parent) then
    warn(&quot;TitleLabel or CostButton not found in the UI hierarchy.&quot;);

    return;
end;

local function displayPerkInfo() -- Line: 25
    -- upvalues: Title (copy), GetPerkInfo (copy), script_Parent (copy), MessageLabel (copy), emblem (copy)
    local Text = Title.Text;

    if not Text or Text == &quot;&quot; then
        warn(&quot;Perk name is empty or not set in TitleLabel.&quot;);

        return;
    end;

    local v1 = GetPerkInfo:InvokeServer(Text);

    if not v1 then
        warn(&quot;[Client] Failed to retrieve perk info for:&quot;, Text);
        script_Parent.Text = &quot;Error&quot;;
        script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
        script_Parent.AutoButtonColor = false;

        if MessageLabel then
            MessageLabel.Text = &quot;Failed to load perk info.&quot;;
        end;

        return;
    end;

    local price = v1.price;
    local owned = v1.owned;
    local message = v1.message;
    emblem.Visible = false;

    if owned then
        script_Parent.Text = &quot;Owned&quot;;
        script_Parent.AutoButtonColor = false;
        script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
        script_Parent.Active = false;
        emblem.Visible = false;
    elseif price then
        script_Parent.Text = tostring(price) .. &quot;&quot;;
        script_Parent.AutoButtonColor = true;
        script_Parent.BackgroundColor3 = Color3.fromRGB(255, 255, 0);
        script_Parent.Active = true;
        emblem.Visible = true;
    else
        script_Parent.Text = &quot;Price not available&quot;;
        script_Parent.AutoButtonColor = false;
        script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
        script_Parent.Active = false;
        emblem.Visible = false;
    end;

    if MessageLabel then
        MessageLabel.Text = message;
    end;
end;

script_Parent.MouseButton1Click:Connect(function() -- Line: 81
    -- upvalues: Title (copy), PurchasePerk (copy)
    local Text = Title.Text;

    if Text and Text ~= &quot;&quot; then
        PurchasePerk:FireServer(Text);

