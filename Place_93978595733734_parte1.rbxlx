local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;);
local Players = game:GetService(&quot;Players&quot;);
local Shop = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;):WaitForChild(&quot;Shop&quot;);
local EquipPerk = Shop:WaitForChild(&quot;EquipPerk&quot;);
local UnequipPerk = Shop:WaitForChild(&quot;UnequipPerk&quot;);
local GetEquippedPerks = Shop:WaitForChild(&quot;GetEquippedPerks&quot;);
local _ = Players.LocalPlayer;
local script_Parent = script.Parent;
local Parent = script_Parent.Parent;
local Title = Parent:FindFirstChild(&quot;Title&quot;);
local Slot = Parent.Parent.loadout:FindFirstChild(&quot;Slot&quot;);

if not (Title and Slot) then
    warn(&quot;Title or Slot not found in Info frame.&quot;);

    return;
end;

local function extractSlotNumber(p1) -- Line: 23
    return tonumber(p1:match(&quot;%d+&quot;));
end;

