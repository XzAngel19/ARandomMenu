        price(Body.Unlock, v100.price and (tostring(v100.price) or &quot;CLAIM&quot;) or &quot;CLAIM&quot;, v100.price ~= nil);
    else
        price(Body.Unlock, v101:upper(), false);
    end;

    local v105 = PassConfig.skipRoom(p75.exp, p75.now);
    Body.Skip.Visible = v105 &gt; 0;
    Body.Skip.Label.Text = v105 == 1 and &quot;SKIP 1 TIER&quot; or `SKIP {v105} TIERS`;
    Body.Skip:SetAttribute(&quot;Room&quot;, v105);
    Body.SkipGift.Visible = PassConfig.open(p75.now);
    local v106;

    if Body.Showcase:GetAttribute(&quot;Shown&quot;) == v80 then
        v106 = nil;
    else
        v106 = u1.showcase(p74, v80);
    end;

    u1.clock(p74, p75.now);

    return v80, v106;
end;

