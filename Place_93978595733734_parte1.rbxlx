    -- upvalues: Title (copy), GetEquippedPerks (copy), Slot (copy), script_Parent (copy)
    local Text = Title.Text;
    local v2 = GetEquippedPerks:InvokeServer();
    local v3 = tonumber(Slot.Value:match(&quot;%d+&quot;));

    if not (v2 and v3) then
        warn(&quot;Failed to fetch equipped perks or invalid slot.&quot;);

        return;
    end;

    if v2[v3] and v2[v3].name == Text then
        script_Parent.Text = &quot;Unequip&quot;;
        script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
        script_Parent.TextColor3 = Color3.fromRGB(255, 255, 255);
        script_Parent.AutoButtonColor = false;

        return;
    end;

    script_Parent.Text = &quot;Equip&quot;;
    script_Parent.BackgroundColor3 = Color3.fromRGB(0, 170, 0);
    script_Parent.TextColor3 = Color3.fromRGB(255, 255, 255);
    script_Parent.AutoButtonColor = true;
end;

script_Parent.MouseButton1Click:Connect(function() -- Line: 63
