local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;);
local Players = game:GetService(&quot;Players&quot;);
local Shop = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;):WaitForChild(&quot;Shop&quot;);
local LevelUpPerk = Shop:WaitForChild(&quot;LevelUpPerk&quot;);
local GetPerkInfo = Shop:WaitForChild(&quot;GetPerkInfo&quot;);
local _ = Players.LocalPlayer;
local screwsimage = script.Parent.screwsimage;
local arrow1 = script.Parent.arrow1;
local arrow2 = script.Parent.arrow2;
local arrow3 = script.Parent.arrow3;
local Perks = ReplicatedStorage:WaitForChild(&quot;Perks&quot;);
screwsimage.Visible = false;
arrow1.Visible = false;
arrow2.Visible = false;
arrow3.Visible = false;
local script_Parent = script.Parent;
local Parent = script_Parent.Parent;
local Title = Parent:FindFirstChild(&quot;Title&quot;);
local MessageLabel = Parent:FindFirstChild(&quot;MessageLabel&quot;);

if not Title then
    warn(&quot;Title label not found in Info frame.&quot;);

    return;
end;

local Preview = script.Parent.Parent.Frame:WaitForChild(&quot;Preview&quot;);

