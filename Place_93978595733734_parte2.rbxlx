        script_Parent.AutoButtonColor = false;
        script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
        script_Parent.Active = false;
    end;

    if not MessageLabel then
        return;
    end;

    MessageLabel.Text = p3;
end);
Title:GetPropertyChangedSignal(&quot;Text&quot;):Connect(function() -- Line: 116
