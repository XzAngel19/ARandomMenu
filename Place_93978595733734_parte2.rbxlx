<Weight>400</Weight>
<Style>Normal</Style>
</Font>
<float name="LineHeight">0.750000000000</float>
<string name="LocalizedText">Whilst not being in chase, gain a &lt;font color=&quot;#CD7F32&quot;&gt;8&lt;/font&gt;/&lt;font color=&quot;#3FBF3F&quot;&gt;10&lt;/font&gt;/&lt;font color=&quot;#E53935&quot;&gt;12&lt;/font&gt;% &lt;font color=&quot;#66CCFF&quot;&gt;Speed boost&lt;/font&gt;. When getting within &lt;font color=&quot;#CD7F32&quot;&gt;50 studs&lt;/font&gt; of a &lt;font color=&quot;#4A90E2&quot;&gt;Survivor&lt;/font&gt; who isn&apos;t trapped in a &lt;font color=&quot;#7FC8F8&quot;&gt;Chain&lt;/font&gt;, this perk deactivates and you gain &lt;font color=&quot;#CD7F32&quot;&gt;3&lt;/font&gt;/&lt;font color=&quot;#3FBF3F&quot;&gt;5&lt;/font&gt;/&lt;font color=&quot;#E53935&quot;&gt;7&lt;/font&gt; seconds of &lt;font color=&quot;#66CCFF&quot;&gt;Undetectable&lt;/font&gt;. The &lt;font color=&quot;#66CCFF&quot;&gt;Undetectable&lt;/font&gt; has a cooldown of &lt;font color=&quot;#CD7F32&quot;&gt;45 seconds&lt;/font&gt;.
&lt;br/&gt;&quot;Absolute cinema&quot;</string>
<string name="Name">perk1desc</string>
<UDim2 name="Position">
<XS>0.550000011921</XS>
<XO>0</XO>
<YS>2.391499996185</YS>
<YO>0</YO>
