local Inventory = Parent:FindFirstChild(&quot;Inventory&quot;);
local medalpage = Parent:FindFirstChild(&quot;medalpage&quot;);

if not Shop then
    warn(&quot;Shop frame not found!&quot;);

    return;
end;

script_Parent.Activated:Connect(function() -- Line: 14, Name: toggleShop
    -- upvalues: Shop (copy), Inventory (copy), medalpage (copy)
    Shop.Visible = not Shop.Visible;

    if Inventory then
        Inventory.Visible = false;
    end;

    if medalpage then
        medalpage.Visible = false;
    end;
end);
local UserInputService = game:GetService(&quot;UserInputService&quot;);
local Sound = script:FindFirstChild(&quot;Sound&quot;);
local AudioBus = require(game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;Audio&quot;):WaitForChild(&quot;AudioBus&quot;));
UserInputService.InputBegan:Connect(function(p1, p2) -- Line: 32
    -- upvalues: Shop (copy), Inventory (copy), medalpage (copy), Sound (copy), AudioBus (copy)
    if p2 then
        return;
    end;

    if p1.UserInputType == Enum.UserInputType.Gamepad1 and p1.KeyCode == Enum.KeyCode.ButtonX then
