local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;);
local WindowMotion = require(ReplicatedStorage.Modules.Spectate.WindowMotion);
local script_Parent = script.Parent;
local Parent = script.Parent.Parent.Parent.Parent;
local Inventory = Parent:FindFirstChild(&quot;Inventory&quot;);
local Shop = Parent:FindFirstChild(&quot;Shop&quot;);
local medalpage = Parent:FindFirstChild(&quot;medalpage&quot;);

if not Inventory then
    warn(&quot;Inventory frame not found!&quot;);

    return;
end;

script_Parent.Activated:Connect(function() -- Line: 16, Name: toggleShop
    -- upvalues: Inventory (copy), WindowMotion (copy), Shop (copy), medalpage (copy)
    if Inventory.Visible then
        WindowMotion.close(Inventory);
    else
        Inventory.Visible = true;
    end;

    if Shop then
        Shop.Visible = false;
    end;

    if medalpage then
        medalpage.Visible = false;
    end;
end);
local UserInputService = game:GetService(&quot;UserInputService&quot;);
local Sound = script:FindFirstChild(&quot;Sound&quot;);
local AudioBus = require(game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;Audio&quot;):WaitForChild(&quot;AudioBus&quot;));
UserInputService.InputBegan:Connect(function(p1, p2) -- Line: 38
    -- upvalues: Inventory (copy), WindowMotion (copy), Shop (copy), medalpage (copy), Sound (copy), AudioBus (copy)
    if p2 then
        return;
    end;

    if p1.UserInputType == Enum.UserInputType.Gamepad1 and p1.KeyCode == Enum.KeyCode.ButtonY then
        if Inventory.Visible then
            WindowMotion.close(Inventory);
        else
            Inventory.Visible = true;
        end;

        if Shop then
            Shop.Visible = false;
        end;

        if medalpage then
            medalpage.Visible = false;
        end;

        if Sound then
            Sound.PlaybackSpeed = math.random(110, 130) / 100;
            AudioBus.restart(Sound);
        end;
    end;
end);</ProtectedString>
<ProtectedString name="Source">-- Decompiled with Potassium&apos;s decompiler.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;);
local WindowMotion = require(ReplicatedStorage.Modules.Spectate.WindowMotion);
local script_Parent = script.Parent;
local Parent = script.Parent.Parent.Parent.Parent;
local Inventory = Parent:FindFirstChild(&quot;Inventory&quot;);
local Shop = Parent:FindFirstChild(&quot;Shop&quot;);
local medalpage = Parent:FindFirstChild(&quot;medalpage&quot;);

if not Inventory then
    warn(&quot;Inventory frame not found!&quot;);

    return;
end;

script_Parent.Activated:Connect(function() -- Line: 16, Name: toggleShop
    -- upvalues: Inventory (copy), WindowMotion (copy), Shop (copy), medalpage (copy)
    if Inventory.Visible then
        WindowMotion.close(Inventory);
    else
        Inventory.Visible = true;
    end;

    if Shop then
        Shop.Visible = false;
    end;

    if medalpage then
        medalpage.Visible = false;
    end;
end);
local UserInputService = game:GetService(&quot;UserInputService&quot;);
local Sound = script:FindFirstChild(&quot;Sound&quot;);
local AudioBus = require(game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;Audio&quot;):WaitForChild(&quot;AudioBus&quot;));
UserInputService.InputBegan:Connect(function(p1, p2) -- Line: 38
    -- upvalues: Inventory (copy), WindowMotion (copy), Shop (copy), medalpage (copy), Sound (copy), AudioBus (copy)
    if p2 then
        return;
    end;

    if p1.UserInputType == Enum.UserInputType.Gamepad1 and p1.KeyCode == Enum.KeyCode.ButtonY then
        if Inventory.Visible then
            WindowMotion.close(Inventory);
        else
            Inventory.Visible = true;
        end;

        if Shop then
            Shop.Visible = false;
        end;

        if medalpage then
            medalpage.Visible = false;
        end;

        if Sound then
            Sound.PlaybackSpeed = math.random(110, 130) / 100;
            AudioBus.restart(Sound);
        end;
    end;
end);</ProtectedString>
