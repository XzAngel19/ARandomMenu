<Style>Normal</Style>
</Font>
<float name="LineHeight">0.750000000000</float>
<string name="LocalizedText">Whenever a &lt;font color=&quot;#4A90E2&quot;&gt;Survivor&lt;/font&gt; within your &lt;font color=&quot;#C29EFF&quot;&gt;Intent Radius&lt;/font&gt; fast vaults, medium vaults, or drops a &lt;font color=&quot;#7FC8F8&quot;&gt;Pallet&lt;/font&gt;, &lt;font color=&quot;#8E63D2&quot;&gt;reveal their aura&lt;/font&gt; to you for &lt;font color=&quot;#CD7F32&quot;&gt;4&lt;/font&gt;/&lt;font color=&quot;#3FBF3F&quot;&gt;5&lt;/font&gt;/&lt;font color=&quot;#E53935&quot;&gt;6&lt;/font&gt; seconds. Additionally, this perk increases any &lt;font color=&quot;#8E63D2&quot;&gt;aura-read duration&lt;/font&gt; by &lt;font color=&quot;#CD7F32&quot;&gt;2 seconds&lt;/font&gt;. This perk has a cooldown of &lt;font color=&quot;#CD7F32&quot;&gt;30 seconds&lt;/font&gt;.
&lt;br/&gt;&quot;Never again letting them escape.&quot;</string>
<string name="Name">perk1desc</string>
<UDim2 name="Position">
<XS>0.550000011921</XS>
<XO>0</XO>
