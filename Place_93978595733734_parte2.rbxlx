        return;
    end;

    local v3 = Frame:Clone();
    v3.Name = p1;
    v3.Visible = true;
    v3.Parent = script_Parent;
    KillerCard.applyTheme(v3, p1);
    local ImageButton = v3:FindFirstChild(&quot;ImageButton&quot;);

    if ImageButton then
        ImageButton:SetAttribute(&quot;KillerName&quot;, p1);
    else
        warn(&quot;ImageButton not found in frame:&quot;, v3.Name);
    end;

    local ModelViewport = v3:FindFirstChild(&quot;ModelViewport&quot;);

    if ModelViewport and ModelViewport:IsA(&quot;ViewportFrame&quot;) then
        KillerCard.setupViewport(ModelViewport, p2);
    else
        warn(&quot;ViewportFrame not found in frame:&quot;, v3.Name);
    end;

    local Owned = v3:FindFirstChild(&quot;Owned&quot;);

    if Owned then
        Owned.Visible = CheckKillerOwnership:InvokeServer(p1);

        return;
    end;

    warn(&quot;\&apos;Owned\&apos; label not found in frame:&quot;, v3.Name);
end;

