local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;);
local Players = game:GetService(&quot;Players&quot;);
local Shop = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;):WaitForChild(&quot;Shop&quot;);
local PurchaseEmote = Shop:WaitForChild(&quot;PurchaseEmote&quot;);
local GetEmoteInfo = Shop:WaitForChild(&quot;GetEmoteInfo&quot;);
local _ = Players.LocalPlayer;
local PassRedirect = require(ReplicatedStorage.Modules.Spectate.PassRedirect);
