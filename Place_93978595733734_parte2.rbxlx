local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;);
local Players = game:GetService(&quot;Players&quot;);
local Shop = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;):WaitForChild(&quot;Shop&quot;);
local EquipItem = Shop:WaitForChild(&quot;EquipItem&quot;);
local UnequipItem = Shop:WaitForChild(&quot;UnequipItem&quot;);
local GetEquippedItems = Shop:WaitForChild(&quot;GetEquippedItems&quot;);
local _ = Players.LocalPlayer;
local script_Parent = script.Parent;
local Title = script_Parent.Parent:FindFirstChild(&quot;Title&quot;);

if not (Title and Title:IsA(&quot;TextLabel&quot;)) then
    warn(&quot;[ItemEquip] Title TextLabel not found in Info frame.&quot;);

    return;
end;

local function setUnequippedState() -- Line: 22
    -- upvalues: script_Parent (copy)
    script_Parent.Text = &quot;Equip&quot;;
    script_Parent.BackgroundColor3 = Color3.fromRGB(0, 170, 0);
    script_Parent.TextColor3 = Color3.fromRGB(255, 255, 255);
    script_Parent.AutoButtonColor = true;
end;

local function setEquippedState() -- Line: 29
    -- upvalues: script_Parent (copy)
    script_Parent.Text = &quot;Unequip&quot;;
    script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
    script_Parent.TextColor3 = Color3.fromRGB(255, 255, 255);
    script_Parent.AutoButtonColor = false;
end;

local function updateButtonState() -- Line: 37
    -- upvalues: GetEquippedItems (copy), Title (copy), script_Parent (copy)
    local v1 = GetEquippedItems:InvokeServer();

    if type(v1) ~= &quot;table&quot; then
        warn(&quot;[ItemEquip] Failed to fetch equipped items.&quot;);

        return;
    end;

    if (v1[1] and v1[1].name or nil) == Title.Text then
        script_Parent.Text = &quot;Unequip&quot;;
        script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
        script_Parent.TextColor3 = Color3.fromRGB(255, 255, 255);
        script_Parent.AutoButtonColor = false;

        return;
    end;

    script_Parent.Text = &quot;Equip&quot;;
    script_Parent.BackgroundColor3 = Color3.fromRGB(0, 170, 0);
    script_Parent.TextColor3 = Color3.fromRGB(255, 255, 255);
    script_Parent.AutoButtonColor = true;
end;

script_Parent.MouseButton1Click:Connect(function() -- Line: 54
    -- upvalues: Title (copy), script_Parent (copy), EquipItem (copy), UnequipItem (copy), updateButtonState (copy)
    local Text = Title.Text;

    if script_Parent.Text == &quot;Equip&quot; then
        EquipItem:FireServer(Text);
    else
        UnequipItem:FireServer();
    end;

    updateButtonState();
end);
EquipItem.OnClientEvent:Connect(updateButtonState);
UnequipItem.OnClientEvent:Connect(updateButtonState);
Title:GetPropertyChangedSignal(&quot;Text&quot;):Connect(updateButtonState);
updateButtonState();</ProtectedString>
