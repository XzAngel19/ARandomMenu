    -- upvalues: Title (copy), GetPerkInfo (copy), Perks (copy), Preview (copy), script_Parent (copy), screwsimage (copy), arrow1 (copy), arrow2 (copy), arrow3 (copy), MessageLabel (copy)
    local Text = Title.Text;

    if not Text or Text == &quot;&quot; then
        warn(&quot;Perk name is empty or not set.&quot;);

        return;
    end;

    local v1 = GetPerkInfo:InvokeServer(Text);

    if v1 then
        local v2 = v1.level or 1;
        local v3 = v2 == 1 and 1500 or (v2 == 2 and 2000 or nil);
        local v4 = Perks:FindFirstChild(Text);

        if not v4 then
