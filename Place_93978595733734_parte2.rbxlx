local PurchaseKiller = ReplicatedStorage.Remotes.Shop:WaitForChild(&quot;PurchaseKiller&quot;);
local Frame = script_Parent:FindFirstChild(&quot;Template&quot;).Frame;
local KillerCard = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;Spectate&quot;):WaitForChild(&quot;KillerCard&quot;));

if not (Frame and Frame:IsA(&quot;Frame&quot;)) then
    warn(&quot;Template frame not found or is not a Frame!&quot;);

    return;
end;

Frame.Visible = false;

