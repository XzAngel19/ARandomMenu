<Weight>400</Weight>
<Style>Normal</Style>
</Font>
<float name="LineHeight">0.750000000000</float>
<string name="LocalizedText">Whenever you&apos;re spotted for &lt;font color=&quot;#CD7F32&quot;&gt;1.5&lt;/font&gt;/&lt;font color=&quot;#3FBF3F&quot;&gt;1.2&lt;/font&gt;/&lt;font color=&quot;#E53935&quot;&gt;0.9&lt;/font&gt; seconds, reveal the &lt;font color=&quot;#4A90E2&quot;&gt;Survivor&lt;/font&gt; that saw you for &lt;font color=&quot;#8E63D2&quot;&gt;4 seconds&lt;/font&gt; and turn their vision &lt;font color=&quot;#FF7A7A&quot;&gt;monochrome&lt;/font&gt;.
&lt;font color=&quot;#8E63D2&quot;&gt;Echo Of The Void&lt;/font&gt; cannot trigger on &lt;font color=&quot;#4A90E2&quot;&gt;Survivors&lt;/font&gt; for &lt;font color=&quot;#CD7F32&quot;&gt;30 seconds&lt;/font&gt; after they are downed, or while Chained.
Each Survivor has a separate &lt;font color=&quot;#CD7F32&quot;&gt;30-second&lt;/font&gt; cooldown for &lt;font color=&quot;#8E63D2&quot;&gt;Echo Of The Void&lt;/font&gt;.
&lt;br/&gt;&quot;He who is not bold enough to be stared at from across the abyss is not bold enough to stare into it himself.&quot;</string>
<string name="Name">perk1desc</string>
<UDim2 name="Position">
<XS>0.549999952316</XS>
<XO>0</XO>
<YS>2.785243988037</YS>
<YO>0</YO>
</UDim2>
