<Item class="LocalScript" referent="RBX38049">
<Properties>
<ProtectedString name="Source">-- Decompiled with Potassium&apos;s decompiler.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;);
local WindowMotion = require(ReplicatedStorage.Modules.Spectate.WindowMotion);
local script_Parent = script.Parent;
local Parent = script.Parent.Parent.Parent.Parent;
local Inventory = Parent:FindFirstChild(&quot;Inventory&quot;);
local Shop = Parent:FindFirstChild(&quot;Shop&quot;);
local medalpage = Parent:FindFirstChild(&quot;medalpage&quot;);

if Inventory then
    script_Parent.Activated:Connect(function() -- Line: 16
        -- upvalues: Inventory (copy), WindowMotion (copy), Shop (copy), medalpage (copy)
        if Inventory.Visible then
            WindowMotion.close(Inventory);
        else
            Inventory.Visible = true;
        end;

        if Shop then
            Shop.Visible = false;
        end;

        if medalpage then
            medalpage.Visible = false;
        end;
    end);

    return;
end;

warn(&quot;Inventory frame not found!&quot;);</ProtectedString>
