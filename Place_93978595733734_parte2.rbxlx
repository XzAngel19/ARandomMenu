        script_Parent.Text = &quot;Price not available&quot;;
        script_Parent.AutoButtonColor = false;
        script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
        script_Parent.Active = false;

        return;
    end;

    local v4 = CheckKillerOwnership:InvokeServer(p2);
    local v5 = GetSelectedKiller:InvokeServer();

    if not v4 then
        script_Parent.Text = tostring(v3);
        script_Parent.AutoButtonColor = true;
        script_Parent.BackgroundColor3 = Color3.fromRGB(0, 170, 0);
        script_Parent.Active = true;

        return;
    end;

    if v5 == p2 then
        script_Parent.Text = &quot;Equipped&quot;;
        script_Parent.AutoButtonColor = false;
        script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
        script_Parent.Active = false;

        return;
    end;

    script_Parent.Text = &quot;Equip&quot;;
    script_Parent.AutoButtonColor = true;
    script_Parent.BackgroundColor3 = Color3.fromRGB(0, 170, 0);
    script_Parent.Active = true;
end;

