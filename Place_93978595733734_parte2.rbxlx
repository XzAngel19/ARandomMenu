    if not Text or Text == &quot;&quot; then
        warn(&quot;Emote name is empty or not set.&quot;);

        return;
    end;

    local v2 = GetEmoteInfo:InvokeServer(Text);

    if v2 then
        local price = v2.price;
        local typeofcurr = v2.typeofcurr;
        local owned = v2.owned;
        local message = v2.message;
        candy.Visible = false;
        u1 = v2.event == true;

        if owned then
            script_Parent.Text = &quot;Owned&quot;;
            script_Parent.AutoButtonColor = false;
            script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
            script_Parent.Active = false;
            emblem.Visible = false;
            screws.Visible = false;
        elseif v2.event then
            script_Parent.Text = &quot;Event&quot;;
            script_Parent.AutoButtonColor = true;
            script_Parent.BackgroundColor3 = Color3_fromRGB_ret;
            script_Parent.Active = true;
            emblem.Visible = false;
            screws.Visible = false;
        elseif price then
            if typeofcurr == &quot;screws&quot; then
                script_Parent.Text = tostring(price);
                script_Parent.AutoButtonColor = true;
                script_Parent.BackgroundColor3 = Color3.fromRGB(0, 46, 107);
                script_Parent.Active = true;
                emblem.Visible = false;
                screws.Visible = true;
            elseif typeofcurr == &quot;gears&quot; then
                script_Parent.Text = tostring(price);
                script_Parent.AutoButtonColor = true;
                script_Parent.BackgroundColor3 = Color3.fromRGB(255, 255, 0);
                script_Parent.Active = true;
                emblem.Visible = true;
                screws.Visible = false;
            elseif typeofcurr == &quot;candy&quot; then
                script_Parent.Text = tostring(price);
                script_Parent.AutoButtonColor = true;
                script_Parent.BackgroundColor3 = Color3.fromRGB(253, 127, 0);
                script_Parent.Active = true;
                emblem.Visible = false;
                screws.Visible = false;
                candy.Visible = true;
            end;
        else
            script_Parent.Text = &quot;Price not available&quot;;
            script_Parent.AutoButtonColor = false;
            script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
            script_Parent.Active = false;
            emblem.Visible = false;
            screws.Visible = false;
        end;

        if MessageLabel then
            MessageLabel.Text = message;
        end;
    else
        warn(&quot;[Client] Failed to retrieve emote info for:&quot;, Text);
        script_Parent.Text = &quot;Error&quot;;

        if MessageLabel then
            MessageLabel.Text = &quot;Failed to load emote info.&quot;;
        end;
    end;
end;

