        if v2 &gt;= 3 then
            script_Parent.Text = &quot;Max Level&quot;;
            script_Parent.AutoButtonColor = false;
            script_Parent.BackgroundColor3 = Color3.fromRGB(128, 128, 128);
            script_Parent.Active = false;
            screwsimage.Visible = false;
        else
            script_Parent.Text = tostring(v3);
            script_Parent.AutoButtonColor = true;
            script_Parent.BackgroundColor3 = Color3.fromRGB(0, 46, 107);
            script_Parent.Active = true;
            screwsimage.Visible = true;
        end;

        arrow1.Visible = v2 &gt;= 1;
        arrow2.Visible = v2 &gt;= 2;
        arrow3.Visible = v2 &gt;= 3;

        if MessageLabel then
            MessageLabel.Text = v5;
        end;
    else
        warn(&quot;[Client] Failed to retrieve perk info for:&quot;, Text);
        script_Parent.Text = &quot;Error&quot;;

        if MessageLabel then
            MessageLabel.Text = &quot;Failed to load perk info.&quot;;
        end;
    end;
end;

