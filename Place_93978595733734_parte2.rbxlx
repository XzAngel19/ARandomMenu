local MessageLabel = Parent:FindFirstChild(&quot;MessageLabel&quot;);
local screws = script.Parent.screws;
local emblem = script.Parent.emblem;
local candy = script.Parent.candy;
emblem.Visible = false;
screws.Visible = false;

if not Title then
    warn(&quot;Title label not found in Info frame.&quot;);

    return;
end;

