local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;);
local Players = game:GetService(&quot;Players&quot;);
local Shop = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;):WaitForChild(&quot;Shop&quot;);
local PurchaseKiller = Shop:WaitForChild(&quot;PurchaseKiller&quot;);
local CheckKillerOwnership = Shop:WaitForChild(&quot;CheckKillerOwnership&quot;);
local GetKillerPrice = Shop:WaitForChild(&quot;GetKillerPrice&quot;);
local EquipKiller = Shop:WaitForChild(&quot;EquipKiller&quot;);
local GetSelectedKiller = Shop:WaitForChild(&quot;GetSelectedKiller&quot;);
local RefreshUI = Shop:WaitForChild(&quot;RefreshUI&quot;);
local screws = script.Parent.screws;
screws.Visible = false;
local _ = Players.LocalPlayer;
local script_Parent = script.Parent;

if not (script_Parent and script_Parent:IsA(&quot;TextButton&quot;)) then
    warn(&quot;CostButton not found or is not a TextButton.&quot;);

    return;
end;

local Parent = script_Parent.Parent;
local MessageLabel = Parent:FindFirstChild(&quot;MessageLabel&quot;);
local SelectedKiller = Parent:FindFirstChild(&quot;SelectedKiller&quot;);

if not SelectedKiller then
    warn(&quot;SelectedKiller value not found in Info frame.&quot;);

    return;
end;

local u1 = nil;

